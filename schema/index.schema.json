{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Virtual-Protocol/butler-skills/main/schema/index.schema.json",
  "title": "Butler skill hub index",
  "description": "Schema for dist/index.json produced by scripts/build_index.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repoTag", "builtAt", "baseUrl", "skills"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "repoTag": { "type": "string" },
    "builtAt": { "type": "string", "format": "date-time" },
    "baseUrl": { "type": "string" },
    "signature": { "type": ["string", "null"] },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "description", "tier", "modes", "moneyMoving", "yanked", "files"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "description": { "type": "string", "maxLength": 160 },
          "tier": { "type": "string", "enum": ["core", "on-demand"] },
          "modes": {
            "type": "array",
            "items": { "type": "string", "enum": ["one-off", "duty"] }
          },
          "moneyMoving": { "type": "boolean" },
          "keywords": {
            "type": "array",
            "items": { "type": "string" }
          },
          "params": {
            "type": "array"
          },
          "requires": {
            "type": "object",
            "properties": {
              "routes": { "type": "array", "items": { "type": "string" } },
              "features": { "type": "array", "items": { "type": "string" } },
              "gates": { "type": "array", "items": { "type": "string" } },
              "bins": { "type": "array", "items": { "type": "string" } }
            }
          },
          "yanked": { "type": "boolean" },
          "source": {
            "type": "object",
            "description": "Additive (git-backed registry): the skill's own repository and the exact commit butler-skills pins it at — a submodule at the commit of tag `ref`. Git-aware clients clone `commit`; v1 clients ignore this and install from files[].",
            "additionalProperties": false,
            "required": ["repo", "commit", "ref"],
            "properties": {
              "repo": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "ref": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,100}$" }
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "bytes"],
              "properties": {
                "path": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "bytes": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
