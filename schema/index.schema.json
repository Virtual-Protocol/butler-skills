{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Virtual-Protocol/butler-skills/main/schema/index.schema.json",
  "title": "Butler duty-template registry index",
  "description": "Schema for dist/index.json produced by scripts/build_index.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "templates"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [3] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "description", "keywords", "triggers", "keys", "files"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "version": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "maxLength": 200 },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "triggers": {
            "type": "array",
            "items": { "type": "string", "enum": ["timer", "group", "trade"] }
          },
          "keys": { "type": "array", "items": { "type": "string" } },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "ref", "commit"],
            "properties": {
              "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
              "ref": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,100}$" },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "bytes"],
              "properties": {
                "path": { "type": "string", "enum": ["recipe.json", "duty.py", "README.md"] },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "bytes": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "supersededBy"],
        "properties": {
          "ref": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}@\\d+$" },
          "supersededBy": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}@\\d+$" }
        }
      }
    }
  }
}
